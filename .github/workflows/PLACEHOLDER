
name: Build Meshwari APKs

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    name: Build Passenger Driver and Admin APKs
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      - name: Prepare application files
        shell: bash
        run: |
          set -e

          test -f capacitor.config.json
          test -f capacitor.admin.config.json
          test -f public/index.html
          test -f public/admin.html
          test -f public/icon-512.png

          mkdir -p build/user/public
          mkdir -p build/admin/admin-build
          mkdir -p dist

          cp -R public/. build/user/public/
          cp -R public/. build/admin/admin-build/

          cp public/admin.html build/admin/admin-build/index.html

          node <<'NODE'
          const fs = require('fs');

          const files = [
            'build/user/public/index.html',
            'build/admin/admin-build/index.html'
          ];

          for (const file of files) {
            let html = fs.readFileSync(file, 'utf8');

            html = html.replace(
              /location\.origin\s*\+\s*['"]\/api['"]/g,
              "'https://meshwari.onrender.com/api'"
            );

            if (!html.includes('https://meshwari.onrender.com/api')) {
              throw new Error('API address was not updated in ' + file);
            }

            fs.writeFileSync(file, html);
            console.log('API configured:', file);
          }
          NODE

      - name: Configure users application
        shell: bash
        run: |
          set -e
          cd build/user

          cp ../../capacitor.config.json capacitor.config.json

          cat > package.json <<'EOF'
          {
            "name": "meshwari-users",
            "version": "1.0.0",
            "private": true,
            "dependencies": {
              "@capacitor/core": "7.4.3",
              "@capacitor/android": "7.4.3",
              "sharp": "0.33.5"
            },
            "devDependencies": {
              "@capacitor/cli": "7.4.3"
            }
          }
          EOF

          npm install --no-audit --no-fund
          npx cap add android
          npx cap sync android

      - name: Configure admin application
        shell: bash
        run: |
          set -e
          cd build/admin

          cp ../../capacitor.admin.config.json capacitor.config.json

          cat > package.json <<'EOF'
          {
            "name": "meshwari-admin",
            "version": "1.0.0",
            "private": true,
            "dependencies": {
              "@capacitor/core": "7.4.3",
              "@capacitor/android": "7.4.3",
              "sharp": "0.33.5"
            },
            "devDependencies": {
              "@capacitor/cli": "7.4.3"
            }
          }
          EOF

          npm install --no-audit --no-fund
          npx cap add android
          npx cap sync android

      - name: Generate Android launcher icons
        shell: bash
        run: |
          set -e

          for APP in user admin; do
            if [ "$APP" = "user" ]; then
              PROJECT="build/user"
              WEB="public"
            else
              PROJECT="build/admin"
              WEB="admin-build"
            fi

            cd "$GITHUB_WORKSPACE/$PROJECT"

            ICON="$WEB/icon-512.png"
            RES="android/app/src/main/res"

            test -f "$ICON"

            rm -rf "$RES/mipmap-anydpi-v26"
            rm -rf "$RES/mipmap-anydpi"

            for ITEM in \
              "mdpi:48" \
              "hdpi:72" \
              "xhdpi:96" \
              "xxhdpi:144" \
              "xxxhdpi:192"
            do
              DENSITY="${ITEM%%:*}"
              SIZE="${ITEM##*:}"

              mkdir -p "$RES/mipmap-$DENSITY"

              ./node_modules/.bin/sharp "$ICON" \
                2>/dev/null || true

              node - "$ICON" "$RES/mipmap-$DENSITY" "$SIZE" <<'NODE'
          const sharp = require('sharp');
          const [,, input, output, size] = process.argv;

          (async () => {
            await sharp(input)
              .resize(Number(size), Number(size), { fit: 'cover' })
              .png()
              .toFile(output + '/ic_launcher.png');

            await sharp(input)
              .resize(Number(size), Number(size), { fit: 'cover' })
              .png()
              .toFile(output + '/ic_launcher_round.png');
          })().catch(error => {
            console.error(error);
            process.exit(1);
          });
          NODE
            done
          done

      - name: Build users APK
        shell: bash
        run: |
          set -e
          cd build/user/android

          chmod +x gradlew
          ./gradlew --no-daemon assembleDebug

          mkdir -p "$GITHUB_WORKSPACE/dist"

          cp app/build/outputs/apk/debug/app-debug.apk \
            "$GITHUB_WORKSPACE/dist/Meshwari-Users.apk"

      - name: Build admin APK
        shell: bash
        run: |
          set -e
          cd build/admin/android

          chmod +x gradlew
          ./gradlew --no-daemon assembleDebug

          mkdir -p "$GITHUB_WORKSPACE/dist"

          cp app/build/outputs/apk/debug/app-debug.apk \
            "$GITHUB_WORKSPACE/dist/Meshwari-Admin.apk"

      - name: Upload APK files
        uses: actions/upload-artifact@v4
        with:
          name: Meshwari-APK-Files
          path: dist/*.apk
          if-no-files-found: error
