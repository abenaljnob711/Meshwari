<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>مشواري - لوحة الإدارة المتكاملة</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&display=swap');
    body { font-family: 'Tajawal', sans-serif; background-color: #f4f6f8; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect } = React;

    const SUPABASE_URL = 'https://fwsizwqzmgrxqdjgtyvm.supabase.co';
    const SUPABASE_ANON_KEY = 'sb_publishable_dvXnOm9j_Jzam6WGXMYVZA_7PZGlLjH';
    const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    function App() {
      const [activeTab, setActiveTab] = useState('passengers');
      const [passengers, setPassengers] = useState([]);
      const [drivers, setDrivers] = useState([]);
      const [trips, setTrips] = useState([]);
      const [reports, setReports] = useState([]);
      const [loading, setLoading] = useState(true);

      const fetchData = async () => {
        setLoading(true);
        const { data: pData } = await supabase.from('passengers').select('*').order('created_at', { ascending: false });
        if (pData) setPassengers(pData);

        const { data: dData } = await supabase.from('drivers').select('*').order('created_at', { ascending: false });
        if (dData) setDrivers(dData);

        const { data: tData } = await supabase.from('trips').select('*').order('created_at', { ascending: false });
        if (tData) setTrips(tData);

        const { data: rData } = await supabase.from('reports').select('*').order('created_at', { ascending: false });
        if (rData) setReports(rData);

        setLoading(false);
      };

      useEffect(() => { fetchData(); }, []);

      // 1. توليد كود للزبون
      const generatePassengerCode = async (nationalId) => {
        const code = Math.floor(100000 + Math.random() * 900000).toString();
        const { error } = await supabase.from('passengers').update({ verification_code: code, is_verified: 1 }).eq('national_id', nationalId);
        if (!error) {
          alert(`تم تفعيل الحساب! الكود الخاص بالزبون هو: ${code}\n\n(قم بنسخ هذا الكود وإرساله له يدوياً عبر الواتساب)`);
          fetchData();
        }
      };

      // 2. اعتماد السائق
      const approveDriver = async (driverId) => {
        await supabase.from('drivers').update({ status: 'approved', is_verified: 1 }).eq('id', driverId);
        fetchData();
      };

      // 3. رفض السائق
      const rejectDriver = async (driverId) => {
        await supabase.from('drivers').update({ status: 'rejected' }).eq('id', driverId);
        fetchData();
      };

      // 4. معالجة البلاغ (اعتماد الغرامة)
      const processReport = async (reportId, decision, driverId, tripId) => {
        if (decision === 'confirmed') {
          // خصم 10,000 ريال من محفظة السائق
          const { data: driver } = await supabase.from('drivers').select('wallet_balance').eq('id', driverId).single();
          if (driver) {
            const newBalance = driver.wallet_balance - 10000;
            await supabase.from('drivers').update({ wallet_balance: newBalance }).eq('id', driverId);
            await supabase.from('transactions_log').insert([{ operation_type: 'غرامة_سيارة', passenger_id: null, driver_id: driverId, trip_id: tripId, amount: 10000, note: 'عدم مطابقة صورة السيارة' }]);
          }
        }
        await supabase.from('reports').update({ status: decision, admin_decision: decision }).eq('id', reportId);
        fetchData();
      };

      const TabButton = ({ id, label, count }) => (
        <button onClick={() => setActiveTab(id)} className={`flex-1 py-3 rounded-xl font-bold transition flex justify-center items-center gap-2 ${activeTab === id ? 'bg-amber-400 text-slate-900 shadow' : 'bg-white text-slate-600 hover:bg-slate-50'}`}>
          {label}
          {count > 0 && <span className="bg-red-500 text-white text-[10px] px-2 py-0.5 rounded-full">{count}</span>}
        </button>
      );

      return (
        <div className="max-w-5xl mx-auto p-4 pb-20">
          <header className="bg-slate-900 text-white p-4 rounded-2xl shadow-lg mb-6 flex justify-between items-center">
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 bg-amber-400 text-slate-900 font-black text-xl rounded-xl flex items-center justify-center">م</div>
              <div>
                <h1 className="font-black text-xl">لوحة إدارة مشواري</h1>
                <p className="text-xs text-amber-300">مركز التحكم والعمليات</p>
              </div>
            </div>
            <button onClick={fetchData} className="bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded-lg text-xs font-bold">تحديث</button>
          </header>

          <div className="flex gap-2 mb-6 overflow-x-auto pb-2">
            <TabButton id="passengers" label="الركاب" count={passengers.filter(p => p.is_verified === 0).length} />
            <TabButton id="drivers" label="السائقون" count={drivers.filter(d => d.status === 'pending').length} />
            <TabButton id="trips" label="الرحلات" count={0} />
            <TabButton id="reports" label="البلاغات" count={reports.filter(r => r.status === 'pending').length} />
          </div>

          <div className="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 min-h-[500px]">
            {loading ? (
              <div className="text-center py-20 text-slate-500 animate-pulse">جارٍ تحميل البيانات...</div>
            ) : (
              <>
                {/* 1. قسم الركاب */}
                {activeTab === 'passengers' && (
                  <div className="space-y-3">
                    <h2 className="text-lg font-black mb-4">إدارة الركاب</h2>
                    {passengers.map(p => (
                      <div key={p.national_id} className="p-4 border border-slate-200 rounded-xl flex justify-between items-center bg-slate-50">
                        <div>
                          <p className="font-bold">{p.full_name}</p>
                          <p className="text-xs text-slate-500 font-mono">بطاقة: {p.national_id} | جوال: {p.phone}</p>
                          <span className={`inline-block mt-1 text-[10px] px-2 py-0.5 rounded-full font-bold ${p.is_verified === 1 ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700'}`}>
                            {p.is_verified === 1 ? 'مفعل' : 'بانتظار التفعيل'}
                          </span>
                        </div>
                        {p.is_verified === 0 && (
                          <button onClick={() => generatePassengerCode(p.national_id)} className="bg-emerald-600 text-white font-bold text-xs px-4 py-2 rounded-lg">توليد كود</button>
                        )}
                      </div>
                    ))}
                  </div>
                )}

                {/* 2. قسم السائقين */}
                {activeTab === 'drivers' && (
                  <div className="space-y-3">
                    <h2 className="text-lg font-black mb-4">إدارة السائقين</h2>
                    {drivers.map(d => (
                      <div key={d.id} className="p-4 border border-slate-200 rounded-xl bg-slate-50">
                        <div className="flex justify-between items-start mb-2">
                          <div>
                            <p className="font-bold text-lg">{d.full_name}</p>
                            <p className="text-xs text-slate-500 font-mono">بطاقة: {d.national_id} | جوال: {d.phone}</p>
                          </div>
                          <div className="text-left">
                            <span className={`text-xs px-2 py-1 rounded-lg font-bold block mb-1 ${d.status === 'approved' ? 'bg-emerald-100 text-emerald-700' : d.status === 'rejected' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>
                              {d.status === 'approved' ? 'معتمد' : d.status === 'rejected' ? 'مرفوض' : 'قيد المراجعة'}
                            </span>
                            <span className="text-xs font-mono text-slate-600 block">المحفظة: {d.wallet_balance} ريال</span>
                          </div>
                        </div>
                        
                        <div className="grid grid-cols-2 gap-2 text-xs mb-3 bg-white p-2 rounded-lg border">
                          <p><span className="text-slate-400">السيارة:</span> {d.car_type} - {d.car_model}</p>
                          <p><span className="text-slate-400">اللون:</span> {d.car_color}</p>
                          <p><span className="text-slate-400">اللوحة:</span> {d.plate_number}</p>
                          <p><span className="text-slate-400">الملكية:</span> {d.registration_number}</p>
                        </div>

                        {d.status === 'pending' && (
                          <div className="flex gap-2">
                            <button onClick={() => approveDriver(d.id)} className="flex-1 bg-emerald-600 text-white font-bold text-xs py-2 rounded-lg">اعتماد</button>
                            <button onClick={() => rejectDriver(d.id)} className="flex-1 bg-red-600 text-white font-bold text-xs py-2 rounded-lg">رفض</button>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                )}

                {/* 3. قسم الرحلات */}
                {activeTab === 'trips' && (
                  <div className="space-y-3">
                    <h2 className="text-lg font-black mb-4">سجل الرحلات</h2>
                    {trips.length === 0 && <p className="text-slate-500 text-sm">لا توجد رحلات مسجلة بعد.</p>}
                    {trips.map(t => (
                      <div key={t.id} className="p-3 border border-slate-200 rounded-xl bg-slate-50 text-xs space-y-1">
                        <div className="flex justify-between font-bold">
                          <span>رحلة #{t.id}</span>
                          <span className={t.status === 'completed' ? 'text-emerald-600' : 'text-amber-600'}>{t.status}</span>
                        </div>
                        <p>الراكب: <span className="font-mono">{t.passenger_id}</span></p>
                        <p>السائق ID: {t.driver_id || 'غير محدد'}</p>
                        <p>المسافة: {t.distance_km || 0} كم | الأجرة: {t.fare_amount || 0} ريال</p>
                      </div>
                    ))}
                  </div>
                )}

                {/* 4. قسم البلاغات */}
                {activeTab === 'reports' && (
                  <div className="space-y-3">
                    <h2 className="text-lg font-black mb-4">بلاغات عدم مطابقة السيارات</h2>
                    {reports.length === 0 && <p className="text-slate-500 text-sm">لا توجد بلاغات حالياً.</p>}
                    {reports.map(r => (
                      <div key={r.id} className="p-4 border border-slate-200 rounded-xl bg-slate-50">
                        <div className="flex justify-between mb-2">
                          <span className="font-bold text-sm">بلاغ #{r.id} (رحلة {r.trip_id})</span>
                          <span className={`text-[10px] font-bold px-2 py-1 rounded ${r.status === 'pending' ? 'bg-amber-100 text-amber-700' : r.status === 'confirmed' ? 'bg-red-100 text-red-700' : 'bg-slate-200'}`}>{r.status}</span>
                        </div>
                        <p className="text-xs mb-3">{r.description || 'الراكب أفاد بعدم مطابقة لون السيارة للصورة.'}</p>
                        
                        {r.status === 'pending' && (
                          <div className="flex gap-2">
                            <button onClick={() => processReport(r.id, 'confirmed', r.driver_id, r.trip_id)} className="flex-1 bg-red-600 text-white font-bold text-xs py-2 rounded-lg">تأكيد المخالفة (خصم 10,000)</button>
                            <button onClick={() => processReport(r.id, 'rejected', r.driver_id, r.trip_id)} className="flex-1 bg-slate-300 text-slate-700 font-bold text-xs py-2 rounded-lg">رفض البلاغ</button>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                )}
              </>
            )}
          </div>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
